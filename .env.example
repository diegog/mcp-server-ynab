# YNAB Personal Access Token.
# Create one at https://app.ynab.com/settings/developer
YNAB_ACCESS_TOKEN=

# Optional: default plan (budget) id, so tools can omit planId.
# "last-used" is accepted by the YNAB API.
# YNAB_DEFAULT_PLAN_ID=last-used

# Optional: serve the read surface alone — write tools are not registered at all,
# so the model never sees them. Anything but blank, "0" or "false" turns it on,
# and the --read-only flag does the same.
# YNAB_READ_ONLY=true

# Optional: how long a read stays fresh, in seconds. Defaults to 60. A write
# clears the plan's cached reads whatever this is set to; 0 sends every read to
# YNAB, which the 200-per-hour limit rarely affords.
# YNAB_CACHE_TTL_SECONDS=60


# --- The remote entrypoint (`npm run dev:http`) only ---------------------------
#
# Serves the same tools over HTTP, for clients that cannot spawn a process —
# claude.ai on the web and mobile. It is an OAuth authorization server for those
# clients and an OAuth client to YNAB: each user signs in to YNAB themselves, and
# YNAB_ACCESS_TOKEN above is not read. See AGENTS.md, "The remote surface".

# Required: the public origin the server is reached at, with no path. Every
# absolute URL — issuer, YNAB callback, resource identifier — derives from this
# and never from a request. The URL to paste into a client is exactly
# `$PUBLIC_URL/mcp`. https:// except for http://localhost on a local run.
# PUBLIC_URL=https://ynab-mcp.example.com

# Required: a YNAB OAuth application from https://app.ynab.com/settings/developer,
# registered with the redirect URI `$PUBLIC_URL/oauth/ynab/callback`.
# YNAB_OAUTH_CLIENT_ID=
# YNAB_OAUTH_CLIENT_SECRET=

# Required: 32 random bytes, base64 — `openssl rand -base64 32`. Seals every
# user's YNAB tokens at rest and signs the sign-in cookie. Losing it signs
# everyone out; changing it does the same.
# YNAB_TOKEN_ENCRYPTION_KEY=

# Optional: where the SQLite store lives. Defaults to /data/ynab-mcp.sqlite.
# YNAB_STORE_PATH=/data/ynab-mcp.sqlite

# Optional: a client known in advance, which is how a family deployment works —
# the id goes into claude.ai's custom-connector "Advanced settings" and no
# registration endpoint is ever exposed. Any string; it is not a secret. The
# redirect URIs default to claude.ai's callback; give a space-separated list to
# change them.
# MCP_CLIENT_ID=claude
# MCP_CLIENT_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback

# Optional: serve `/register` so any client can register itself (RFC 7591).
# Off unless set; what a client without a pre-registered id falls back to.
# MCP_DYNAMIC_REGISTRATION=1

# Optional: where to listen. Defaults to 127.0.0.1:8080; a container binds 0.0.0.0.
# PORT=8080
# HOST=127.0.0.1
