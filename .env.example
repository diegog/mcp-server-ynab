# YNAB Personal Access Token.
# Create one at https://app.ynab.com/settings/developer
YNAB_ACCESS_TOKEN=

# Optional: default plan (budget) id, so tools can omit planId.
# "last-used" is accepted by the YNAB API.
# YNAB_DEFAULT_PLAN_ID=last-used

# Optional: serve the read surface alone — write tools are not registered at all,
# so the model never sees them. Anything but blank, "0" or "false" turns it on,
# and the --read-only flag does the same.
# YNAB_READ_ONLY=true

# Optional: how long a read stays fresh, in seconds. Defaults to 60. A write
# clears the plan's cached reads whatever this is set to; 0 sends every read to
# YNAB, which the 200-per-hour limit rarely affords.
# YNAB_CACHE_TTL_SECONDS=60
